{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^../../generated/prisma/client$": "<rootDir>/test/mocks/prisma-client",
    "^@generated/prisma/enums$": "<rootDir>/test/mocks/enums",
    "^@generated/prisma/(.*)$": "<rootDir>/test/mocks/enums"
  }
}
